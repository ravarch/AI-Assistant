/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pij",
	"main": "src/entry.py",
	"compatibility_date": "2024-09-27",
	"compatibility_flags": [
		"python_workers"
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
    // AI Binding for LLM text generation
    "ai": {
        "binding": "AI"
    },
    // Durable Objects for Chat/State History
    "durable_objects": {
    "bindings": [
      {
        "name": "LISTS",
        "class_name": "List"
      }
    ]
  },
	"migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "List"
      ]
    }
  ],
	"observability": {
		"enabled": true
	},
    // Smart Placement optimizes where the worker runs based on API/DB location
	"placement": {  "mode": "smart" }
}
